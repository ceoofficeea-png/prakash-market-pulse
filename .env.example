# Copy to .env and fill in from Supabase → Project Settings → API.
# Variable names only: never commit real values.

# --- Browser (Vite) ---------------------------------------------------------
# Read by src/integrations/supabase/client.ts. The publishable (anon) key is
# public by design; RLS still decides what a signed-in user may read.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Server runtime (SSR server functions) ----------------------------------
# Read by src/integrations/supabase/client.ts and auth-middleware.ts.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# --- Server only ------------------------------------------------------------
# Service role: bypasses RLS. Used by admin user management and task progress
# writes (src/integrations/supabase/client.server.ts). Never expose it to the
# browser, never prefix it with VITE_, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Migrations (optional) --------------------------------------------------
# Direct Postgres connection string for `bun x drizzle-kit push`.
LOVABLE_DB_MIGRATION_URL=
